<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#F1F5F9">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="وِرْدِي • الورد اليومي" android:textStyle="bold" android:textColor="#0F766E" android:textSize="15sp"/>
    <TextView android:id="@+id/daily_wird_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 / 5 صفحات" android:textColor="#0F172A" android:textSize="14sp" android:paddingTop="5dp"/>
    <TextView android:id="@+id/daily_azkar_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الأذكار المتبقية: 0" android:textColor="#334155" android:textSize="12sp"/>
    <TextView android:id="@+id/daily_next_prayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الصلاة القادمة • --:--" android:textColor="#0F766E" android:textStyle="bold" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/daily_refresh" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="تحديث ↻" android:textColor="#0F766E" android:textStyle="bold"/>
        <TextView android:id="@+id/daily_open" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="فتح وِرْدِي" android:textColor="#0F766E"/>
    </LinearLayout>
</LinearLayout>