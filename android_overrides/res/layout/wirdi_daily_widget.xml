<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/wirdi_widget_surface_light">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="وِرْدِي  •  وِرْد اليوم"
        android:textStyle="bold"
        android:textColor="#0C5D4D"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <View android:layout_width="34dp" android:layout_height="2dp"
        android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
        android:background="#C5A45A" />

    <TextView android:id="@+id/daily_wird_progress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="إنجاز الورد  •  0 / 5 صفحات"
        android:textColor="#173D35" android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView android:id="@+id/daily_azkar_remaining"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="الأذكار المتبقية: 0"
        android:textColor="#58716B" android:textSize="11sp" />

    <TextView android:id="@+id/daily_next_prayer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="الصلاة القادمة • --:--"
        android:textColor="#0C5D4D" android:textStyle="bold" android:textSize="12sp" />

    <TextView android:id="@+id/daily_countdown"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="متبقي -- دقيقة" android:textColor="#58716B" android:textSize="11sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:orientation="horizontal">
        <TextView android:id="@+id/daily_refresh" android:layout_width="0dp"
            android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
            android:text="↻ تحديث" android:textColor="#0C5D4D" android:textStyle="bold"
            android:background="@drawable/wirdi_widget_action" />
        <View android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/daily_open" android:layout_width="0dp"
            android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
            android:text="فتح وِرْدِي" android:textColor="#0C5D4D"
            android:background="@drawable/wirdi_widget_action" />
    </LinearLayout>
</LinearLayout>