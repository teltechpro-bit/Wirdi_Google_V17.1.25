rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /family_khatmas/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.claims.size() == 0
        && request.resource.data.rounds == 1;

      // A member may only add their own membership entry. They cannot
      // change the owner, name, claims, or round while joining.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] is string
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name == resource.data.name
        && request.resource.data.claims == resource.data.claims
        && request.resource.data.rounds == resource.data.rounds;

      // Existing members may modify only their own claims map.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims'])
        && request.resource.data.claims.diff(resource.data.claims).affectedKeys().hasOnly([request.auth.uid]);

      // A non-owner may remove only their own membership entry.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid != resource.data.ownerUid
        && !(request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name == resource.data.name
        && request.resource.data.claims == resource.data.claims
        && request.resource.data.rounds == resource.data.rounds;

      // The owner may start a new round by clearing claims and incrementing
      // the round counter; all identity and membership fields stay immutable.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims', 'rounds'])
        && request.resource.data.rounds == resource.data.rounds + 1
        && request.resource.data.claims.size() == 0;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && resource.data.memberUids.size() == 1;
    }
  }
}