rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /family_khatmas/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.resource.data.memberUids.size() == 1
                    && request.resource.data.memberUids[0] == request.auth.uid
                    && request.resource.data.members is map
                    && request.resource.data.members.keys().hasAll([request.auth.uid])
                    && request.resource.data.rounds == 1
                    && request.resource.data.claims is map;

      allow update: if signedIn()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.name == resource.data.name
                    && request.resource.data.rounds is int
                    && request.resource.data.rounds >= resource.data.rounds
                    && (
                      (
                        isMember(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'claims', 'rounds'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rounds'])
                            || resource.data.ownerUid == request.auth.uid)
                        && (
                          request.resource.data.memberUids == resource.data.memberUids
                          || (
                            request.resource.data.memberUids is list
                            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
                            && !(request.auth.uid in request.resource.data.memberUids)
                          )
                        )
                      )
                      ||
                      (
                        request.resource.data.memberUids is list
                        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                        && request.auth.uid in request.resource.data.memberUids
                        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
                      )
                    );

      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;
    }
  }
}